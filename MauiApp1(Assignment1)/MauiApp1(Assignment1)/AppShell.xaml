<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1_Assignment1_.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiApp1_Assignment1_.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="MauiApp1_Assignment1_">

    <!-- The first item is the page the app opens on -->
    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent
        Title="Customers"
        Route="CustomerListPage"
        ContentTemplate="{DataTemplate views:CustomerListPage}" />

</Shell>